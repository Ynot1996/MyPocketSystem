@{
    ViewData["Title"] = Localizer["TryItNow"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-5 text-center" style="min-height: 60vh;">
    <div class="spinner-border text-primary mb-4" role="status" aria-hidden="true"></div>
    <h2 class="fw-bold">@Localizer["PreparingDemo"]</h2>
    <p class="text-muted">@Localizer["PreparingDemoHint"]</p>

    <form id="startGuestForm" asp-action="StartGuest" method="post">
        <noscript>
            <button type="submit" class="btn btn-dark btn-lg mt-3">@Localizer["TryItNow"]</button>
        </noscript>
    </form>
</div>
@section Scripts {
    <script>
        // Real browsers start the demo immediately; crawlers (no JS) never POST.
        document.getElementById('startGuestForm').submit();
    </script>
}
