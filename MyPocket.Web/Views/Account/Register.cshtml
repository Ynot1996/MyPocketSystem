@model MyPocket.Shared.ViewModels.Accounts.RegisterViewModel

@{
    ViewData["Title"] = Localizer["SignUp"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var googleEnabled = ViewData["GoogleEnabled"] as bool? ?? false;
    var isGuest = ViewData["IsGuest"] as bool? ?? false;
}

<div class="container py-5" style="min-height: 80vh; background: linear-gradient(135deg, #fff 0%, #f6f7fb 100%);">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="bg-white rounded-4 shadow-sm p-5 border border-1">
                <h2 class="fw-bold mb-2 text-center" style="color:#222; letter-spacing:-1px;">@Localizer[isGuest ? "SaveYourDemo" : "CreateYourAccount"]</h2>
                @if (isGuest)
                {
                    <p class="text-center text-muted mb-4">@Localizer["GuestKeepDataHint"]</p>
                }
                else
                {
                    <div class="mb-4"></div>
                }

                @if (googleEnabled)
                {
                    <form asp-action="ExternalLogin" method="post" class="mb-3">
                        <input type="hidden" name="provider" value="Google" />
                        <button type="submit" class="btn btn-outline-dark btn-lg w-100 d-flex align-items-center justify-content-center gap-2" style="border-radius:8px;">
                            <i class="bi bi-google"></i><span>@Localizer["SignInWithGoogle"]</span>
                        </button>
                    </form>
                    <div class="d-flex align-items-center my-3 text-muted">
                        <hr class="flex-grow-1" /><small class="px-2">@Localizer["Or"]</small><hr class="flex-grow-1" />
                    </div>
                }

                <form asp-action="Register" method="post" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">@Localizer["EmailAddress"]</label>
                        <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">@Localizer["Password"]</label>
                        <input asp-for="Password" class="form-control form-control-lg" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">@Localizer["ConfirmPassword"]</label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" type="password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nickname" class="form-label">@Localizer["Nickname"]</label>
                        <input asp-for="Nickname" class="form-control form-control-lg" />
                        <span asp-validation-for="Nickname" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-dark btn-lg w-100 mt-3" style="border-radius:8px;">@Localizer["SignUp"]</button>
                </form>
                <div class="text-center mt-4">
                    <span class="text-muted">@Localizer["AlreadyHaveAccount"]</span>
                    <a asp-action="Login" class="ms-1 link-primary">@Localizer["Login"]</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
