@{
    ViewData["Title"] = Localizer["Login"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var googleEnabled = ViewData["GoogleEnabled"] as bool? ?? false;
}
<div class="container py-5" style="min-height: 80vh; background: linear-gradient(135deg, #fff 0%, #f6f7fb 100%);">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="bg-white rounded-4 shadow-sm p-5 border border-1">
                <h2 class="fw-bold mb-4 text-center" style="color:#222; letter-spacing:-1px;">@Localizer["LogInToYourAccount"]</h2>

                @if (googleEnabled)
                {
                    <form asp-action="ExternalLogin" method="post" class="mb-3">
                        <input type="hidden" name="provider" value="Google" />
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        <button type="submit" class="btn btn-outline-dark btn-lg w-100 d-flex align-items-center justify-content-center gap-2"
                                style="border-radius:8px;">
                            <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
                                <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20c11.1 0 19.9-8 19.9-20 0-1.2-.1-2.3-.3-3.5z"/>
                                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.6 6.1 29.6 4 24 4 16 4 9 8.3 6.3 14.7z"/>
                                <path fill="#4CAF50" d="M24 44c5.5 0 10.4-2.1 14.1-5.5l-6.5-5.5c-2 1.4-4.6 2.3-7.6 2.3-5.2 0-9.6-3.3-11.3-8l-6.5 5C8.9 39.6 15.9 44 24 44z"/>
                                <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.3 5.7l6.5 5.5C40.9 36 44 30.5 44 24c0-1.2-.1-2.3-.4-3.5z"/>
                            </svg>
                            <span>@Localizer["SignInWithGoogle"]</span>
                        </button>
                    </form>
                    <div class="d-flex align-items-center my-3 text-muted">
                        <hr class="flex-grow-1" />
                        <small class="px-2">@Localizer["Or"]</small>
                        <hr class="flex-grow-1" />
                    </div>
                }

                <form asp-action="Login" method="post" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label for="email" class="form-label">@Localizer["EmailAddress"]</label>
                        <input type="text" name="email" class="form-control form-control-lg" required autocomplete="username" />
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">@Localizer["Password"]</label>
                        <input type="password" name="password" class="form-control form-control-lg" required autocomplete="current-password" />
                    </div>
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <button type="submit" class="btn btn-dark btn-lg w-100 mt-3" style="border-radius:8px;">@Localizer["Login"]</button>
                </form>
                <div class="text-center mt-4">
                    <span class="text-muted">@Localizer["DontHaveAccount"]</span>
                    <a asp-action="Register" class="ms-1 link-primary">@Localizer["SignUp"]</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
