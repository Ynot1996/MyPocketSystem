@model MyPocket.Core.Models.User
@{
    ViewData["Title"] = Localizer["EditUser"];
    var roles = new[] { "FreeMember", "PaidMember", "Admin" };
}

<h1>@Localizer["EditUser"]</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit" asp-route-id="@Model.UserId" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label" for="email">@Localizer["EmailAddress"]</label>
                <input class="form-control" id="email" name="email" type="email" value="@Model.Email" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="nickname">@Localizer["Nickname"]</label>
                <input class="form-control" id="nickname" name="nickname" value="@Model.Nickname" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="role">@Localizer["Role"]</label>
                <select class="form-select" id="role" name="role">
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(r == Model.Role)">@r</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="newPassword">@Localizer["NewPasswordOptional"]</label>
                <input class="form-control" id="newPassword" name="newPassword" type="password" minlength="8" autocomplete="new-password" />
                <div class="form-text">@Localizer["NewPasswordHint"]</div>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="isDeleted" name="isDeleted" value="true" @(Model.IsDeleted ? "checked" : "") />
                <label class="form-check-label" for="isDeleted">@Localizer["Disabled"]</label>
            </div>
            <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["BackToList"]</a>
        </form>
    </div>
</div>
