@{
    ViewData["Title"] = Localizer["AddUser"];
    var roles = new[] { "FreeMember", "PaidMember", "Admin" };
}

<h1>@Localizer["AddUser"]</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label" for="email">@Localizer["EmailAddress"]</label>
                <input class="form-control" id="email" name="email" type="email" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">@Localizer["Password"]</label>
                <input class="form-control" id="password" name="password" type="password" minlength="8" required autocomplete="new-password" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="nickname">@Localizer["Nickname"]</label>
                <input class="form-control" id="nickname" name="nickname" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="role">@Localizer["Role"]</label>
                <select class="form-select" id="role" name="role">
                    @foreach (var r in roles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">@Localizer["Create"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["BackToList"]</a>
        </form>
    </div>
</div>
