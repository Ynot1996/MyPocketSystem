@model IEnumerable<MyPocket.Core.Models.Transaction>
@using System.Text.Json
@using MyPocket.Shared.ViewModels.Gamification
@{
    ViewData["Title"] = Localizer["Dashboard"];
    var city = ViewBag.City as CityViewModel;
    var coins = (int?)ViewBag.Coins ?? 0;
    var streak = (int?)ViewBag.Streak ?? 0;
    var budgets = ViewBag.Budgets as List<MyPocket.Shared.ViewModels.Budgets.BudgetViewModel> ?? new();
    var goal = (ViewBag.SavingGoals as List<MyPocket.Core.Models.SavingGoal>)?.FirstOrDefault();

    // This month's totals, every row converted into the display currency first.
    var display = Currency.CurrentCode;
    var monthStart = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    var thisMonth = Model.Where(t => t.TransactionDate >= monthStart).ToList();
    decimal Total(string type) => thisMonth
        .Where(t => t.TransactionType.Trim() == type)
        .Sum(t => ExchangeRates.Convert(t.Amount, string.IsNullOrEmpty(t.Currency) ? "GBP" : t.Currency, display));
    var income = Total("收入");
    var expense = Total("支出");

    var budgetTotal = budgets.Sum(b => b.Amount);
    var budgetSpent = budgets.Sum(b => b.Spent);
    var budgetPct = budgetTotal == 0 ? 0 : (int)Math.Min(100, budgetSpent / budgetTotal * 100);

    var cityJson = city == null ? "null" : JsonSerializer.Serialize(new
    {
        grid = city.GridSize,
        buildings = city.Buildings.Select(b => new
        {
            slot = b.Slot,
            level = b.Level,
            emoji = b.Emoji,
            color = b.Color,
            category = b.CategoryKey,
            name = $"{Localizer["Building_" + b.BuildingType]} ({Localizer[b.CategoryKey]})",
            count = b.TransactionCount,
            next = b.NextLevelAt
        }),
        decorations = city.Decorations.Select(d => new { slot = d.Slot, emoji = d.Emoji }),
        characters = city.Characters.Select(c => new { emoji = c.Emoji }),
        outfit = city.EquippedOutfitEmoji,
        labels = new
        {
            level = Localizer["Level"].ToString(),
            entries = Localizer["Entries"].ToString(),
            nextAt = Localizer["NextLevelAt"].ToString(),
            maxLevel = Localizer["MaxLevel"].ToString(),
            empty = Localizer["CityEmpty"].ToString(),
            aria = Localizer["CityAria"].ToString()
        }
    });

    var coinsEarned = TempData["CoinsEarned"] as int?;
    var streakDays = TempData["StreakDays"] as int?;
    var capReached = TempData["CoinsCapReached"] as bool? ?? false;
}

@if (coinsEarned.HasValue)
{
    <div class="coin-toast" role="status">
        <span class="coin-toast-coin">🪙</span>
        <div>
            <div class="fw-bold">+@coinsEarned @Localizer["Coins"]</div>
            @if (streakDays > 1)
            {
                <div class="small">🔥 @string.Format(Localizer["StreakDaysLabel"], streakDays)</div>
            }
        </div>
    </div>
}
else if (capReached)
{
    <div class="coin-toast coin-toast-muted" role="status"><div class="small">@Localizer["DailyCoinCapReached"]</div></div>
}

<div class="dash">
    <div class="dash-head">
        <div>
            <h1 class="dash-title">@string.Format(Localizer["HelloName"], User.FindFirst("Nickname")?.Value ?? "")</h1>
            <div class="text-muted small">@Localizer["DashboardSubtitle"]</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Shop" asp-action="Index" class="coin-chip" title="@Localizer["OpenShop"]">🪙 @coins</a>
            <span class="streak-chip" title="@Localizer["StreakHint"]">🔥 @streak</span>
        </div>
    </div>

    <div class="kpi-strip">
        <div class="kpi"><span class="kpi-label">@Localizer["IncomeThisMonth"]</span><span class="kpi-value text-success">@Currency.Format(income)</span></div>
        <div class="kpi"><span class="kpi-label">@Localizer["ExpenseThisMonth"]</span><span class="kpi-value text-danger">@Currency.Format(expense)</span></div>
        <div class="kpi"><span class="kpi-label">@Localizer["Balance"]</span><span class="kpi-value">@Currency.Format(income - expense)</span></div>
        <div class="kpi">
            <span class="kpi-label">@Localizer["MonthlyBudget"]</span>
            @if (budgetTotal > 0)
            {
                <div class="progress kpi-progress" role="progressbar" aria-valuenow="@budgetPct" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(budgetSpent > budgetTotal ? "bg-danger" : "bg-primary")" style="width:@budgetPct%"></div>
                </div>
                <span class="small text-muted">@budgetPct% · @Currency.Format(budgetTotal - budgetSpent) @Localizer["Left"]</span>
            }
            else
            {
                <a asp-controller="Budgets" asp-action="Create" class="small">@Localizer["SetABudget"]</a>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="mp-card city-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0"><i class="bi bi-buildings me-1"></i>@Localizer["YourCity"]</h5>
                    <div class="d-flex gap-2">
                        <a asp-controller="Shop" asp-action="Index" class="btn btn-sm btn-outline-dark"><i class="bi bi-bag-heart me-1"></i>@Localizer["Shop"]</a>
                        <a asp-controller="Insights" asp-action="Index" class="btn btn-sm btn-outline-dark"><i class="bi bi-graph-up me-1"></i>@Localizer["Insights"]</a>
                    </div>
                </div>
                <div id="city" class="city"></div>
                <script type="application/json" id="cityData">@Html.Raw(cityJson)</script>
                <div class="text-muted small mt-2"><i class="bi bi-info-circle me-1"></i>@Localizer["CityHowItWorks"]</div>
            </div>

            <div class="mp-card mt-4">
                @await Html.PartialAsync("ListPartial", Model)
            </div>
        </div>
        <div class="col-lg-4">
            @await Html.PartialAsync("CreatePartial", Model)

            @if (goal != null)
            {
                var goalPct = goal.TargetAmount > 0 ? (int)Math.Min(100, goal.CurrentAmount / goal.TargetAmount * 100) : 0;
                <div class="mp-card mt-4">
                    <div class="d-flex justify-content-between">
                        <h6 class="fw-bold mb-1"><i class="bi bi-piggy-bank me-1"></i>@Localizer.LocalizeGoalName(goal.GoalName)</h6>
                        <a asp-controller="SavingGoals" asp-action="Index" class="small">@Localizer["Manage"]</a>
                    </div>
                    @if (goal.TargetAmount > 0)
                    {
                        <div class="progress my-2" style="height:.6rem"><div class="progress-bar bg-success" style="width:@goalPct%"></div></div>
                        <div class="small text-muted">@Currency.Format(goal.CurrentAmount) / @Currency.Format(goal.TargetAmount)</div>
                    }
                    else
                    {
                        <a asp-controller="SavingGoals" asp-action="Edit" asp-route-id="@goal.GoalId" class="small">@Localizer["SetATarget"]</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/transaction-form.js" asp-append-version="true"></script>
    <script src="~/js/capture.js" asp-append-version="true"></script>
    <script src="~/js/city.js" asp-append-version="true"></script>
    <script>
        // Keyboard shortcut: press "n" anywhere (outside a field) to jump to the form.
        document.addEventListener('keydown', e => {
            if (e.key !== 'n' || e.metaKey || e.ctrlKey || /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) return;
            e.preventDefault();
            document.getElementById('quickText')?.focus();
        });
    </script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
